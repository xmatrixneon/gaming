# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL
# Format: postgres://user:password@host:port/database
# Note: The casino-postgres Docker container uses port 5433 (not 5432)
DATABASE_URL=postgres://postgres:casino_password@localhost:5433/casino_db

# ============================================================================
# BETTER AUTH CONFIGURATION
# ============================================================================

# Better Auth Base URL
# Set this to your production domain in production
BETTER_AUTH_URL=http://localhost:3000

# Better Auth API Key (optional - for SMS service and other features)
# Get your API key from https://betterauth.com
# BETTER_AUTH_API_KEY=your_api_key_here

# Better Auth Encryption Key
# Used to encrypt OAuth tokens (access_token, refresh_token) in database
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this key secret and rotate periodically
BETTER_AUTH_ENCRYPTION_KEY=your_encryption_key_here

# Better Auth Secret Key
# Used to sign session cookies and tokens
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this key secret and rotate periodically
BETTER_AUTH_SECRET=your_secret_key_here

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis Host
REDIS_HOST=localhost

# Redis Port
REDIS_PORT=6379

# Redis Password (optional)
# REDIS_PASSWORD=your_redis_password

# Redis Database Number (optional, defaults to 0)
# REDIS_DB=0

# Redis URL (alternative to individual settings)
# Format: redis://[:password@]host:port/db
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# GOOGLE OAUTH
# ============================================================================

# Google OAuth Client ID
# Get your credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# SMS CONFIGURATION (Optional - for phone authentication)
# ============================================================================

# Option 1: Better Auth Infrastructure SMS Service
# Requires Pro plan or higher
# BETTER_AUTH_API_KEY=your_api_key_here

# Option 2: Twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Option 3: AWS SNS
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ============================================================================
# GAME API CONFIGURATION
# ============================================================================

# Game API Credentials
# Get your credentials from the Game API provider
GAME_API_AGENCY_UID=8dee1e401b87408cca3ca813c2250cb4
GAME_API_AES_KEY=68b074393ec7c5a975856a90bd6fdf47
GAME_API_SERVER_URL=https://jsgame.live

# Game API Callback URL
# This is where Game API will send bet settlement callbacks
# Must be publicly accessible and use HTTPS in production
GAME_API_CALLBACK_URL=https://your-domain.com/api/webhook/game-api

# Game API IP Whitelist (comma-separated list)
# Only accept callback requests from these IPs (empty = allow all - development only)
GAME_API_IP_WHITELIST=1.2.3.4,5.6.7.8

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# VeloPay Payment Gateway (Indian UPI)
VELOPAY_GATEWAY_URL=https://velopay.ptasm.online
VELOPAY_MERCHANT_NO=201
VELOPAY_SECRET_KEY=1f23c2295a08e214304bf09463d0fbcb
VELOPAY_CALLBACK_URL=https://your-domain.com/api/webhook/velopay

# OKPay Payment Gateway (Indian UPI)
# Mode: sandbox for testing, production for live
OKPAY_MODE=sandbox

# OKPay Gateway Host (production URL)
OKPAY_HOST=https://okpay.com

# Merchant Credentials (obtain from OKPay)
OKPAY_MCH_ID=your_merchant_id
OKPAY_KEY=your_secret_key

# Base callback URL
OKPAY_CALLBACK_URL=https://yourdomain.com/api/webhook/okpay

# UPI Payment Gateway URL (legacy - for compatibility)
NEXT_PUBLIC_UPI_GATEWAY_URL=https://your-payment-gateway.com/upi

# Crypto Payment Gateway URL (legacy - for compatibility)
NEXT_PUBLIC_CRYPTO_GATEWAY_URL=https://your-payment-gateway.com/crypto

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Node environment
NODE_ENV=development

# Application port (optional, defaults to 3000)
# PORT=3000
