      "id": "fallow_agile_workflow",
      "label": "Agile/Scrum Workflow Rules",
      "file_type": "document",
      "source_file": ".fallow/agile-workflow.md"
    },
    {
      "id": "fallow_agile_workflow_sprint_structure",
      "label": "Sprint Structure",
      "file_type": "rationale",
      "source_file": ".fallow/agile-workflow.md",
      "rationale": "1-week sprints with daily 6-hour productive capacity per developer, 20% buffer for unplanned work, 80% commitment rate"
    },
    {
      "id": "fallow_agile_workflow_story_points",
      "label": "Story Points Estimation",
      "file_type": "rationale",
      "source_file": ".fallow/agile-workflow.md",
      "rationale": "Fibonacci-like scale (1,2,3,5,8,13) based on complexity not time, ~3 hours per point, split stories over 8 points"
    },
    {
      "id": "fallow_agile_workflow_dor",
