      "id": "fallow_agile_workflow_incident_response",
      "label": "Incident Response Process",
      "file_type": "rationale",
      "source_file": ".fallow/agile-workflow.md",
      "rationale": "Severity-based SLAs (L0: immediate, L1: 1hr), blameless post-mortems focused on process improvement"
    },
