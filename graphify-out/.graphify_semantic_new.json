    {
      "id": "fallow_coding_standards",
      "label": "Coding Standards & Conventions",
      "file_type": "document",
      "source_file": ".fallow/coding-standards.md"
    },
    {
      "id": "fallow_coding_standards_file_naming",
      "label": "File Naming Conventions",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "kebab-case for components/hooks/utilities, descriptive suffixes (.types.ts, .constants.ts) for type definition files"
    },
    {
      "id": "fallow_coding_standards_component_structure",
      "label": "Component Structure Pattern",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Strict ordering: imports → types → component → hooks → effects → handlers → derived values → render, 'use client' only when needed"
    },
    {
      "id": "fallow_coding_standards_import_order",
      "label": "Import Order Convention",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "React core → third-party → shadcn/ui → local components → hooks → utilities → types, enables easy dependency scanning"
    },
    {
      "id": "fallow_coding_standards_styling",
      "label": "Styling Conventions",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Priority: Tailwind utilities > shadcn variants > CSS variables > inline (dynamic only), game-* prefix for custom utilities"
    },
    {
      "id": "fallow_coding_standards_typescript",
      "label": "TypeScript Conventions",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Interface for object shapes, type for unions/aliases, extend shadcn props, descriptive generic names, strict mode enabled"
    },
    {
      "id": "fallow_coding_standards_state_management",
      "label": "State Management Strategy",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Local: useState/useReducer, Shared: Zustand, Server: TanStack Query via tRPC, clear separation of concerns"
    },
    {
      "id": "fallow_coding_standards_performance",
      "label": "Performance Optimization",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Code split heavy components, memoize expensive computations/callbacks, use transform for GPU-accelerated animations"
    },
    {
      "id": "fallow_coding_standards_accessibility",
      "label": "Accessibility Standards",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "ARIA labels on interactive elements, keyboard navigation support, WCAG AA contrast (4.5:1), semantic HTML"
    },
    {
      "id": "fallow_coding_standards_testing",
      "label": "Testing Conventions",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Test user behavior not implementation, prefer role-based queries, meaningful test names, Testing Library patterns"
    },
    {
      "id": "fallow_coding_standards_security",
      "label": "Security Practices",
      "file_type": "rationale",
      "source_file": ".fallow/coding-standards.md",
      "rationale": "Avoid dangerouslySetInnerHTML, sanitize with DOMPurify, never log sensitive data, use env vars, tRPC handles CSRF"
    },
    {
      "id": "fallow_design_system",
      "label": "Design System Guidelines",
      "file_type": "document",
      "source_file": ".fallow/design-system.md"
    },
    {
      "id": "fallow_design_system_color_system",
      "label": "Color System",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "OKLCH color space for consistency, --game-* prefix, hierarchical backgrounds/borders/text, semantic status colors, accent colors for decoration"
    },
    {
      "id": "fallow_design_system_typography",
      "label": "Typography System",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Inter (UI), Rajdhani (display), JetBrains Mono (code), Tailwind scale with custom sizes, weight hierarchy (400-700), WCAG contrast compliance"
    },
    {
      "id": "fallow_design_system_spacing",
      "label": "Spacing System",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Tailwind 4px base scale, component-specific presets (input/button/card padding), section gaps (28/40px), mobile-first approach"
    },
    {
      "id": "fallow_design_system_border_radius",
      "label": "Border Radius Scale",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "6px (sm) → 8px (md buttons/inputs) → 12px (lg cards) → 16px (xl modals) → 9999px (full pills/badges)"
    },
    {
      "id": "fallow_design_system_animation",
      "label": "Animation & Motion",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Duration-fast (150ms) → normal (200ms) → slow (400ms), custom easing (ease-game, ease-bounce), respect prefers-reduced-motion, GPU-accelerated transforms only"
    },
    {
      "id": "fallow_design_system_component_states",
      "label": "Component States",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Defined states for buttons/inputs/cards (default, hover, active, focus, disabled/error), loading/empty/error state patterns with skeleton/spinners"
    },
    {
      "id": "fallow_design_system_responsive",
      "label": "Responsive Design",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Mobile-first approach, Tailwind breakpoints (sm:640, md:768, lg:1024, xl:1280, 2xl:1536), responsive containers/grids/typography patterns"
    },
    {
      "id": "fallow_design_system_accessibility",
      "label": "Accessibility Design",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Focus-visible rings, ARIA labels, semantic HTML, keyboard navigation, screen reader support, skip links"
    },
    {
      "id": "fallow_design_system_dark_mode",
      "label": "Dark Mode Implementation",
      "file_type": "rationale",
      "source_file": ".fallow/design-system.md",
      "rationale": "Dark-first design for gaming platform, CSS variables for automatic switching, consistent component support"
    },
